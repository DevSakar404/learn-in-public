# Copy to .env.local and fill in. Never commit real values.

# Supabase (local values come from `supabase status -o env`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Seed scripts only (never read by the app runtime)
SUPABASE_SECRET_KEY=your-secret-key
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Site
SITE_URL=http://localhost:3000
SITE_TIMEZONE=Asia/Kolkata

# LLM (switch provider by changing these two lines)
LLM_PROVIDER=google
# Lite models have the highest free-tier limits; the newest flagship models are often overloaded.
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
OPENAI_API_KEY=
